import React, { useState } from 'react';

import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  FlatList,
  StyleSheet,
  Modal,
  Alert,
  SafeAreaView,
  StatusBar,
  ScrollView,
} from 'react-native';

const COURSE_OPTIONS = ['Starter', 'Main Course', 'Dessert'];

const FILTER_OPTIONS = ['All', ...COURSE_OPTIONS];

function FormInput({
  label,
  value,
  onChangeText,
  placeholder,
  keyboardType = 'default',
  multiline = false,
}) {
  return (
    <View style={styles.inputGroup}>
      <Text style={styles.inputLabel}>{label}</Text>

      <TextInput
        style={[
          styles.input,
          multiline && styles.multilineInput,
        ]}
        value={value}
        onChangeText={onChangeText}
        placeholder={placeholder}
        placeholderTextColor="#999999"
        keyboardType={keyboardType}
        multiline={multiline}
      />
    </View>
  );
}

function StatisticCard({ title, value }) {
  return (
    <View style={styles.statCard}>
      <Text style={styles.statValue}>{value}</Text>
      <Text style={styles.statTitle}>{title}</Text>
    </View>
  );
}

function MenuCard({ item, onEdit, onDelete }) {
  return (
    <View style={styles.menuCard}>
      <View style={styles.menuCardContent}>
        <View style={styles.menuItemHeading}>
          <Text style={styles.dishName}>{item.name}</Text>

          <Text style={styles.dishPrice}>
            R {Number(item.price).toFixed(2)}
          </Text>
        </View>

        <Text style={styles.courseBadge}>{item.option}</Text>

        <Text style={styles.dishDescription}>
          {item.description}
        </Text>

        <View style={styles.actionButtons}>
          <TouchableOpacity
            style={styles.editButton}
            onPress={() => onEdit(item)}
          >
            <Text style={styles.buttonText}>Edit</Text>
          </TouchableOpacity>

          <TouchableOpacity
            style={styles.deleteButton}
            onPress={() => onDelete(item.id)}
          >
            <Text style={styles.buttonText}>Delete</Text>
          </TouchableOpacity>
        </View>
      </View>
    </View>
  );
}

export default function App() {
  const [dishName, setDishName] = useState('');
  const [description, setDescription] = useState('');
  const [priceInput, setPriceInput] = useState('');
  const [selectedCourse, setSelectedCourse] = useState('');

  const [menuItems, setMenuItems] = useState([]);

  const [searchText, setSearchText] = useState('');
  const [activeFilter, setActiveFilter] = useState('All');

  const [editingId, setEditingId] = useState(null);

  const [courseModalVisible, setCourseModalVisible] =
    useState(false);

  const resetMenuForm = () => {
    setDishName('');
    setDescription('');
    setPriceInput('');
    setSelectedCourse('');
    setEditingId(null);
  };

  const validateMenuForm = () => {
    if (
      !dishName.trim() ||
      !description.trim() ||
      !priceInput.trim() ||
      !selectedCourse
    ) {
      Alert.alert(
        'Missing Information',
        'Please complete all fields before saving.'
      );

      return false;
    }

    const numericPrice = Number(priceInput);

    if (!Number.isFinite(numericPrice) || numericPrice < 0) {
      Alert.alert(
        'Invalid Price',
        'Please enter a valid price of zero or more.'
      );

      return false;
    }

    return true;
  };

  const handleSaveMenuItem = () => {
    if (!validateMenuForm()) {
      return;
    }

    const newMenuItem = {
      id: editingId || Date.now().toString(),
      name: dishName.trim(),
      description: description.trim(),
      price: Number(priceInput),
      option: selectedCourse,
    };

    if (editingId) {
      setMenuItems((previousItems) =>
        previousItems.map((item) =>
          item.id === editingId ? newMenuItem : item
        )
      );

      Alert.alert('Success', 'Menu item updated successfully.');
    } else {
      setMenuItems((previousItems) => [
        ...previousItems,
        newMenuItem,
      ]);

      Alert.alert('Success', 'Menu item added successfully.');
    }

    resetMenuForm();
  };

  const handleEditMenuItem = (item) => {
    setDishName(item.name);
    setDescription(item.description);
    setPriceInput(String(item.price));
    setSelectedCourse(item.option);
    setEditingId(item.id);
  };

  const handleDeleteMenuItem = (id) => {
    Alert.alert(
      'Delete Menu Item',
      'Are you sure you want to delete this item?',
      [
        {
          text: 'Cancel',
          style: 'cancel',
        },
        {
          text: 'Delete',
          style: 'destructive',
          onPress: () => {
            setMenuItems((previousItems) =>
              previousItems.filter((item) => item.id !== id)
            );

            if (editingId === id) {
              resetMenuForm();
            }
          },
        },
      ]
    );
  };

  const filteredMenuItems = menuItems.filter((item) => {
    const matchesSearch = item.name
      .toLowerCase()
      .includes(searchText.trim().toLowerCase());

    const matchesCourse =
      activeFilter === 'All' ||
      item.option === activeFilter;

    return matchesSearch && matchesCourse;
  });

  const totalItems = menuItems.length;

  const totalPrice = menuItems.reduce(
    (total, item) => total + Number(item.price),
    0
  );

  const averagePrice =
    totalItems > 0 ? totalPrice / totalItems : 0;

  const starterCount = menuItems.filter(
    (item) => item.option === 'Starter'
  ).length;

  const mainCourseCount = menuItems.filter(
    (item) => item.option === 'Main Course'
  ).length;

  const dessertCount = menuItems.filter(
    (item) => item.option === 'Dessert'
  ).length;

  // Main application screen
  return (
    <SafeAreaView style={styles.safeArea}>
      <StatusBar
        barStyle="light-content"
        backgroundColor="#252525"
      />

      <FlatList
        style={styles.container}
        data={filteredMenuItems}
        keyExtractor={(item) => item.id}
        keyboardShouldPersistTaps="handled"
        contentContainerStyle={styles.listContent}
        showsVerticalScrollIndicator={false}
        ListHeaderComponent={
          <View>
            {/* Header */}
            <View style={styles.header}>
              <Text style={styles.headerEmoji}>🍽️</Text>

              <Text style={styles.headerTitle}>
                Chef's Menu Manager
              </Text>

              <Text style={styles.headerSubtitle}>
                Manage your delicious creations
              </Text>
            </View>

            {/* Statistics */}
            <Text style={styles.sectionTitle}>
              Menu Overview
            </Text>

            <View style={styles.statsContainer}>
              <StatisticCard
                title="Total Items"
                value={totalItems}
              />

              <StatisticCard
                title="Average Price"
                value={`R ${averagePrice.toFixed(2)}`}
              />
            </View>

            {/* Course statistics */}
            <View style={styles.courseStatsCard}>
              <Text style={styles.courseStatsTitle}>
                Items by Course
              </Text>

              <View style={styles.courseStatRow}>
                <Text style={styles.courseStatLabel}>
                  Starters
                </Text>

                <Text style={styles.courseStatValue}>
                  {starterCount}
                </Text>
              </View>

              <View style={styles.courseStatRow}>
                <Text style={styles.courseStatLabel}>
                  Main Courses
                </Text>

                <Text style={styles.courseStatValue}>
                  {mainCourseCount}
                </Text>
              </View>

              <View style={styles.courseStatRow}>
                <Text style={styles.courseStatLabel}>
                  Desserts
                </Text>

                <Text style={styles.courseStatValue}>
                  {dessertCount}
                </Text>
              </View>
            </View>

            {/* Add or edit form */}
            <Text style={styles.sectionTitle}>
              {editingId ? 'Edit Menu Item' : 'Add Menu Item'}
            </Text>

            <View style={styles.formCard}>
              <FormInput
                label="Dish Name"
                value={dishName}
                onChangeText={setDishName}
                placeholder="Enter dish name"
              />

              <FormInput
                label="Description"
                value={description}
                onChangeText={setDescription}
                placeholder="Describe the dish"
                multiline
              />

              <FormInput
                label="Price (R)"
                value={priceInput}
                onChangeText={setPriceInput}
                placeholder="Enter price"
                keyboardType="decimal-pad"
              />

              <Text style={styles.inputLabel}>
                Course
              </Text>

              <TouchableOpacity
                style={styles.courseSelector}
                onPress={() => setCourseModalVisible(true)}
              >
                <Text
                  style={[
                    styles.courseSelectorText,
                    !selectedCourse && styles.placeholderText,
                  ]}
                >
                  {selectedCourse || 'Select a course'}
                </Text>

                <Text style={styles.dropdownArrow}>▼</Text>
              </TouchableOpacity>

              <TouchableOpacity
                style={styles.saveButton}
                onPress={handleSaveMenuItem}
              >
                <Text style={styles.saveButtonText}>
                  {editingId ? 'Update Menu Item' : 'Add Menu Item'}
                </Text>
              </TouchableOpacity>

              {editingId && (
                <TouchableOpacity
                  style={styles.cancelButton}
                  onPress={resetMenuForm}
                >
                  <Text style={styles.cancelButtonText}>
                    Cancel Editing
                  </Text>
                </TouchableOpacity>
              )}
            </View>

            {/* Course selection modal */}
            <Modal
              visible={courseModalVisible}
              transparent
              animationType="slide"
              onRequestClose={() =>
                setCourseModalVisible(false)
              }
            >
              <View style={styles.modalOverlay}>
                <View style={styles.modalContent}>
                  <Text style={styles.modalTitle}>
                    Select Course
                  </Text>

                  {COURSE_OPTIONS.map((course) => (
                    <TouchableOpacity
                      key={course}
                      style={styles.modalOption}
                      onPress={() => {
                        setSelectedCourse(course);
                        setCourseModalVisible(false);
                      }}
                    >
                      <Text style={styles.modalOptionText}>
                        {course}
                      </Text>
                    </TouchableOpacity>
                  ))}

                  <TouchableOpacity
                    style={styles.modalCancelButton}
                    onPress={() =>
                      setCourseModalVisible(false)
                    }
                  >
                    <Text style={styles.modalCancelText}>
                      Cancel
                    </Text>
                  </TouchableOpacity>
                </View>
              </View>
            </Modal>

            {/* Search */}
            <Text style={styles.sectionTitle}>
              Find a Dish
            </Text>

            <TextInput
              style={styles.searchInput}
              placeholder="Search menu by dish name..."
              placeholderTextColor="#999999"
              value={searchText}
              onChangeText={setSearchText}
              autoCapitalize="none"
            />

            {/* Scrollable course tabs */}
            <Text style={styles.sectionTitle}>
              Filter by Course
            </Text>

            <ScrollView
              horizontal
              showsHorizontalScrollIndicator={false}
              nestedScrollEnabled
              contentContainerStyle={styles.tabsContainer}
            >
              {FILTER_OPTIONS.map((course) => (
                <TouchableOpacity
                  key={course}
                  style={[
                    styles.tabButton,
                    activeFilter === course &&
                      styles.activeTabButton,
                  ]}
                  onPress={() => setActiveFilter(course)}
                >
                  <Text
                    style={[
                      styles.tabText,
                      activeFilter === course &&
                        styles.activeTabText,
                    ]}
                  >
                    {course}
                  </Text>
                </TouchableOpacity>
              ))}
            </ScrollView>

            {/* Menu list heading */}
            <View style={styles.menuListHeading}>
              <Text style={styles.sectionTitle}>
                Menu Items
              </Text>

              <Text style={styles.itemCount}>
                {filteredMenuItems.length} found
              </Text>
            </View>
          </View>
        }
        renderItem={({ item }) => (
          <MenuCard
            item={item}
            onEdit={handleEditMenuItem}
            onDelete={handleDeleteMenuItem}
          />
        )}
        ListEmptyComponent={
          <View style={styles.emptyContainer}>
            <Text style={styles.emptyEmoji}>🍴</Text>

            <Text style={styles.emptyTitle}>
              No Menu Items Found
            </Text>

            <Text style={styles.emptyMessage}>
              Add a dish or change your search or course filter.
            </Text>
          </View>
        }
        ListFooterComponent={
          <Text style={styles.footerText}>
            Showing {filteredMenuItems.length} of {totalItems}{' '}
            menu items
          </Text>
        }
      />
    </SafeAreaView>
  );
}

